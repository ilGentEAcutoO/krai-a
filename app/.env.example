# Copy to .env and fill in. Never commit .env with real keys.
PORT=8080

# Site role (src/siteMode.js): product (default) = business app; demo = hackathon
# site (call demo at /, live talk, stats/status only; member/pay/LINE/Twilio 404).
SITE_MODE=product
# demo mode: product pages (pricing, start, dashboard...) 302 here.
PRODUCT_BASE_URL=https://krai-a.com
# Firestore snapshot doc (collection/doc). Empty = the role's own doc
# (product krai/snapshot, demo krai/hackathon); off = in-memory only.
# Firestore is only used on Cloud Run (K_SERVICE) or with FIRESTORE_EMULATOR_HOST.
PERSIST_DOC=
MONTHLY_QUOTA_MINUTES=60

# B (default) = one central shared AI number per country; a call is answered only if forwarded from a registered protected number. A = legacy per-household demo numbers.
IDENTIFY_MODE=B
# Central shared AI number per country (E.164, must be domestic: +66… for TH).
# Empty = waitlist: signup works, no forwarding code is shown until it is set.
CENTRAL_NUMBER_TH=

# Gemini (Google AI): escalation verdicts + owner reasons + persona lines.
# Leave empty for canned persona lines + templated reasons.
# Current stable Flash-Lite (fast turns); gemini-2.0-flash was shut down 2026-06-01.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=12000
# Per Gemini call during a live turn (Twilio drops a webhook after 15 s).
GEMINI_TURN_TIMEOUT_MS=4000

# Gemini voice (Google). TTS renders the demo audio; Live = realtime freestyle demo.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_LIVE_MODEL=gemini-3.8-live
# Freestyle "talk to the agent" demo guards: hard cap per session + per-IP + global/day.
LIVE_MAX_SECONDS=120
LIVE_MAX_PER_IP_HOUR=3
LIVE_MAX_PER_DAY=300

# TypeSafe Jev (typed per-turn scam judgment). Server-side only — never ship to the browser.
# get from: https://typesafe.ai (dashboard → API keys)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=4000
# 1 = never call Jev/Gemini (offline dev). Tests are always offline unless AI_LIVE_TESTS=1.
AI_OFFLINE=
AI_LIVE_TESTS=

# Twilio telephony adapter (real phone loop). Leave empty for demo-API only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Verify service SID for real OTP SMS. Empty = mock mode (code shown in browser).
TWILIO_VERIFY_SID=
# The one AI number used in demo (E.164). Must be a Thai number in production
# so forwarded-call charges stay domestic for the owner.
DEMO_NUMBER=+6621000142

# THSMS (Thai OTP SMS). Access Token from the API Key page -- enables live
# OTP delivery for +66 numbers. Empty = mock mode (code shown in browser).
# get from: https://thsms.com/manage/api-key
THSMS_API_KEY=
# Optional custom sender (registered names only). Empty = account default.
THSMS_SENDER=

# Notifications: comma list of console,line (whatsapp,zalo later).
NOTIFY_ADAPTERS=console
LINE_CHANNEL_ACCESS_TOKEN=
# LINE user/group ID to push to (owner). Family watchers get a copy.
LINE_DEFAULT_TO=
# LINE Login (LIFF): Messaging API channel secret + Login channel ID.
# get from: https://developers.line.biz/console/
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
# LIFF app ID from the Login channel -> Linked LIFF app (frontend liff.init).
LINE_LIFF_ID=

# Abuse limits.
MAX_REJECTS_PER_DAY=20
MAX_MINUTES_PER_HOUSE=200
MAX_TURNS_PER_CALL=12

# Talk budget: one call may burn at most this fraction of the plan's monthly
# quota (0.2 → ฿20/10min = 2min, ฿100/50min = 10min). 0 disables.
TALK_BUDGET_FRACTION=0.2

# Demo guards: max public demo starts/hour + idle auto-end (minutes).
DEMO_MAX_CALLS_PER_HOUR=30
DEMO_MAX_CALLS_PER_IP_HOUR=5
DEMO_IDLE_MINUTES=10
# Text/turn demo API (/api/demo/*, /api/analyze, /api/calls, /api/tts).
# Off by default (404): the public demo spends AI money ONLY in the capped
# live session; when Live is down the UI replays pre-rendered scenarios.
# Set 1 only for local testing of the turn-based path.
DEMO_TEXT_API=0

# Trial tombstones (store.js): HMAC key for hashed phones of erased
# households, so an erase + re-signup can't restart the free trial. Put it in
# Secret Manager for production (openssl rand -hex 32). Empty = a random key
# is generated once and kept with the Firestore snapshot.
TRIAL_TOMBSTONE_SECRET=

# Single-shot /api/analyze limits (global/hour + per-IP/minute).
ANALYZE_MAX_PER_HOUR=100
ANALYZE_MAX_PER_IP_MIN=10

# reCAPTCHA v3 (invisible bot gate on demo start). Empty API key = disabled.
# Created via CLI (see deploy-cloudrun.sh comments for the exact commands).
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Seed demo household.
SEED_MEMBER_PHONE=+66810000001
SEED_MEMBER_NAME=Demo Household

# Pre-answer gates: $0 spam defense (unanswered calls are not billed).
# Gate 1: comma list of customer (owner) numbers allowed to forward here.
# Empty = permissive (accept all, for testing/direct mode).
FORWARD_ALLOWLIST=
# Gate 2: caller reputation TTL. SCAM numbers auto-reject repeats until expiry.
REPUTATION_TTL_DAYS=60
# Minimum confidence for a SCAM record to trigger auto-reject.
REPUTATION_MIN_CONFIDENCE=0.8

# Stripe billing (test mode). Empty STRIPE_SECRET_KEY = billing disabled (503).
# Test keys only here — never paste live (rk_live/sk_live) keys into this repo.
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` (whsec_...) or the dashboard.
STRIPE_WEBHOOK_SECRET=
# One-time prices — pricing v2 (Solo 99 / Family 199, annual -25%, seat 59,
# 1-year gifts 990 / 1,990). Create them in YOUR Stripe sandbox and paste the
# price_... ids; unset = that item can't be bought (checkout -> 503).
# TH = THB (card + PromptPay), INTL = USD (card, optional). _YR = annual.
STRIPE_PRICE_SOLO_TH=
STRIPE_PRICE_SOLO_TH_YR=
STRIPE_PRICE_FAMILY_TH=
STRIPE_PRICE_FAMILY_TH_YR=
STRIPE_PRICE_GIFT_SOLO=
STRIPE_PRICE_GIFT_FAMILY=
STRIPE_PRICE_SOLO_INTL=
STRIPE_PRICE_SOLO_INTL_YR=
STRIPE_PRICE_FAMILY_INTL=
STRIPE_PRICE_FAMILY_INTL_YR=
STRIPE_PRICE_GIFT_SOLO_INTL=
STRIPE_PRICE_GIFT_FAMILY_INTL=
# Extra protected number 4-5 on Family: THB 59 / USD 2 per month.
STRIPE_PRICE_SEAT_TH=
STRIPE_PRICE_SEAT_INTL=
# One-time topup packs (extra screening minutes; same test sandbox).
# small = +10 min (THB 29 / USD 2), medium = +30 min (THB 69 / USD 5).
STRIPE_PRICE_TOPUP_SMALL_TH=price_1UOFzwGhqT5QUFe669ZjCk9t
STRIPE_PRICE_TOPUP_SMALL_INTL=price_1UOFzxGhqT5QUFe6WAxh3vI0
STRIPE_PRICE_TOPUP_MEDIUM_TH=price_1UOFzyGhqT5QUFe6EDqVIxfz
STRIPE_PRICE_TOPUP_MEDIUM_INTL=price_1UOFzyGhqT5QUFe6oTlwu4BN

# Telnyx (Thai National DID backup + free US demo number). API v2 key.
# get from: https://portal.telnyx.com/#/api-keys (API Keys > Create API Key)
TELNYX_API_KEY=
